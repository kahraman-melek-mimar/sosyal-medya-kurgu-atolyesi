{
  "name": "sosyal-medya-kurgu-atolyesi",
  "version": "1.0.0",
  "description": "Kahraman MELEK — Sosyal Medya Kurgu Atölyesi: dikey Reels/TikTok/WhatsApp Durum emlak videolarını kodla kurgulama (Remotion + FFmpeg)",
  "repository": {
    "type": "git",
    "url": "https://github.com/kahraman-melek-mimar/sosyal-medya-kurgu-atolyesi"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@remotion/bundler": "4.0.526",
    "@remotion/cli": "4.0.526",
    "@remotion/google-fonts": "4.0.526",
    "@remotion/media": "4.0.526",
    "@remotion/renderer": "4.0.526",
    "@remotion/tailwind-v4": "4.0.526",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.526",
    "tailwindcss": "4.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.526",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "d3-geo": "^3.1.1",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "topojson-client": "^3.1.0",
    "typescript": "5.9.3",
    "world-atlas": "^2.0.2"
  },
  "scripts": {
    "proje": "node scripts/proje.mjs",
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "probe": "node scripts/00-probe.mjs",
    "proxy": "node scripts/10-proxy.mjs",
    "transcribe": "node scripts/20-transcribe.mjs && node scripts/21-review-transcript.mjs",
    "assets": "node scripts/30-normalize-assets.mjs",
    "luts": "node scripts/40-make-luts.mjs",
    "plan:check": "node scripts/50-validate-plan.mjs",
    "render:gfx": "node scripts/50-validate-plan.mjs && node scripts/60-render-segments.mjs",
    "stills": "node scripts/65-design-stills.mjs",
    "composite:draft": "node scripts/70-composite.mjs --draft",
    "composite": "node scripts/70-composite.mjs",
    "qc:draft": "node scripts/80-qc.mjs --file work/composite/draft-hlg.mov --stills",
    "qc": "node scripts/80-qc.mjs --file work/composite/final-hlg.candidate.mov --stills --promote --promote-to out/final-hlg.temiz-ses.mov",
    "audio": "node scripts/lib/synth.mjs && node scripts/75-audio.mjs --mux",
    "qc:mix": "node scripts/80-qc.mjs --file work/composite/final-hlg.mix.candidate.mov --audio mix --clean out/final-hlg.temiz-ses.mov --skip-decode --promote",
    "master": "npm run render:gfx && npm run composite && npm run qc && npm run audio && npm run qc:mix",
    "shorts": "node scripts/90-shorts.mjs",
    "ilan:still": "remotion still src/ilan/giris.ts IlanReel out/ilan-onizleme.png --props=work/ilan-plan.json",
    "ilan:render": "remotion render src/ilan/giris.ts IlanReel out/.ham-dikey.mp4 --props=work/ilan-plan.json --codec=h264 --crf=18 --pixel-format=yuv420p --color-space=bt709 --audio-codec=aac && node scripts/ilan/30-ses-seviyesi.mjs out/.ham-dikey.mp4 out/final-dikey.mp4 --ham-sil",
    "ilan:ses-seviyesi": "node scripts/ilan/30-ses-seviyesi.mjs",
    "ilan:studio": "remotion studio src/ilan/giris.ts --props=work/ilan-plan.json",
    "ilan:seslendir": "node --env-file-if-exists=.env scripts/ilan/10-seslendir.mjs",
    "ilan:avatar": "node --env-file-if-exists=.env scripts/ilan/20-avatar.mjs",
    "ilan:sozluk": "node scripts/ilan/sozluk-pls.mjs",
    "ilan:test": "node scripts/ilan/okunus-test.mjs",
    "ilan:hazirla": "node scripts/ilan/05-hazirla.mjs"
  },
  "sideEffects": [
    "*.css"
  ],
  "author": "Kahraman Melek"
}
